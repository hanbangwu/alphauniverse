{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "openapi-ts && vite dev",
    "build": "openapi-ts && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "openapi-ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "openapi-ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "shadcn": "bunx shadcn-svelte@latest add --yes --overwrite button dialog resizable select separator slider spinner switch table",
    "openapi-ts": "openapi-ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.43.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^24.13.3",
    "bits-ui": "^2.19.1",
    "clsx": "^2.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.6.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.48",
    "@uwdata/mosaic-core": "0.29.2",
    "@uwdata/mosaic-sql": "0.29.0",
    "apache-arrow": "^17.0.0",
    "d3-color": "3.1.0",
    "d3-interpolate": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-scale-chromatic": "3.1.0",
    "echarts": "^6.1.0",
    "embedding-atlas": "^0.22.0",
    "mode-watcher": "^1.1.0",
    "runed": "^0.37.1",
    "zod": "^4.5.4"
  }
}
