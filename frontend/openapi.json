          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/galaxy/{galaxy}": {
      "get": {
        "summary": "Get Galaxy",
        "operationId": "get_galaxy",
        "parameters": [
          {
            "name": "galaxy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "title": "Galaxy"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Galaxy"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Get Search",
        "operationId": "get_search",
        "parameters": [
          {
            "name": "galaxy",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "title": "Galaxy"
            }
          },
          {
            "name": "p",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 576
              },
              "maxItems": 576,
              "default": [],
              "title": "P"
            }
          },
          {
            "name": "s",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 272
              },
              "maxItems": 272,
              "default": [],
              "title": "S"
            }
          },
          {
            "name": "matches",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 128,
              "minimum": 1,
              "default": 32,
              "title": "Matches"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/vnd.apache.arrow.stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Detail": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Detail"
      },
      "Galaxy": {
        "properties": {
          "coverage": {
            "items": {
              "$ref": "#/components/schemas/Survey"
            },
            "type": "array",
            "title": "Coverage"
          }
        },
        "type": "object",
        "required": [
          "coverage"
        ],
        "title": "Galaxy"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Meta": {
        "properties": {
          "author": {
            "type": "string",
            "title": "Author"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          },
          "galaxies": {
            "type": "integer",
            "title": "Galaxies"
          },
          "grid": {
            "type": "integer",
            "title": "Grid"
          },
          "spectrum": {
            "$ref": "#/components/schemas/SpectrumGrid"
          },
          "morphologies": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Morphologies"
          },
          "unlabelled": {
            "type": "integer",
            "title": "Unlabelled"
          }
        },
        "type": "object",
        "required": [
          "author",
          "id",
          "revision",
          "galaxies",
          "grid",
          "spectrum",
          "morphologies",
          "unlabelled"
        ],
        "title": "Meta"
      },
      "SpectrumGrid": {
        "properties": {
          "origin": {
            "type": "number",
            "title": "Origin"
          },
          "width": {
            "type": "number",
            "title": "Width"
          }
        },
        "type": "object",
        "required": [
          "origin",
          "width"
        ],
        "title": "SpectrumGrid"
      },
      "Survey": {
        "properties": {
          "survey": {
            "type": "string",
            "title": "Survey"
          },
          "matched": {
            "type": "boolean",
            "title": "Matched"
          }
        },
        "type": "object",
        "required": [
          "survey",
          "matched"
        ],
        "title": "Survey"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
