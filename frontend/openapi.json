          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Galaxy": {
        "properties": {
          "ls": {
            "type": "boolean",
            "title": "Ls"
          },
          "hsc": {
            "type": "boolean",
            "title": "Hsc"
          },
          "desi": {
            "type": "boolean",
            "title": "Desi"
          },
          "sdss": {
            "type": "boolean",
            "title": "Sdss"
          },
          "gz10": {
            "type": "boolean",
            "title": "Gz10"
          },
          "provabgs": {
            "type": "boolean",
            "title": "Provabgs"
          }
        },
        "type": "object",
        "required": [
          "ls",
          "hsc",
          "desi",
          "sdss",
          "gz10",
          "provabgs"
        ],
        "title": "Galaxy"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Meta": {
        "properties": {
          "author": {
            "type": "string",
            "title": "Author"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "galaxies": {
            "type": "integer",
            "title": "Galaxies"
          },
          "grid": {
            "type": "integer",
            "title": "Grid"
          },
          "spectrum_origin": {
            "type": "number",
            "title": "Spectrum Origin"
          },
          "spectrum_width": {
            "type": "number",
            "title": "Spectrum Width"
          },
          "morphologies": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Morphologies"
          }
        },
        "type": "object",
        "required": [
          "author",
          "id",
          "galaxies",
          "grid",
          "spectrum_origin",
          "spectrum_width",
          "morphologies"
        ],
        "title": "Meta"
      },
      "TableRow": {
        "properties": {
          "section": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ls",
                  "hsc",
                  "desi",
                  "sdss",
                  "gz10",
                  "provabgs"
                ]
              },
              {
                "type": "string",
                "const": "redshift"
              }
            ],
            "title": "Section"
          },
          "column": {
            "type": "string",
            "title": "Column"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "table_value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Table Value"
          },
          "token": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token"
          },
          "excluded": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excluded"
          }
        },
        "type": "object",
        "required": [
          "section",
          "column",
          "value",
          "table_value",
          "token",
          "excluded"
        ],
        "title": "TableRow"
      },
      "TextMatches": {
        "properties": {
          "galaxies": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Galaxies"
          },
          "scores": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Scores"
          }
        },
        "type": "object",
        "required": [
          "galaxies",
          "scores"
        ],
        "title": "TextMatches"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
