{
  "openapi": "3.1.0",
  "info": {
    "title": "alphauniverse",
    "version": "0.1.0"
  },
  "paths": {
    "/meta": {
      "get": {
        "summary": "Get Meta",
        "description": "Dataset identity, size, patch grid, artifact roles and label counts.",
        "operationId": "get_meta",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            }
          }
        }
      }
    },
    "/artifacts/{role}": {
      "get": {
        "summary": "Get Artifact",
        "description": "Download a build artifact by role.",
        "operationId": "get_artifact",
        "parameters": [
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Role"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/galaxies/{galaxy}/image.png": {
      "get": {
        "summary": "Get Image",
        "description": "The galaxy's anchor-survey cutout as a PNG.",
        "operationId": "get_image",
        "parameters": [
          {
            "name": "galaxy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMaximum": 17369,
              "title": "Galaxy"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/galaxies/{galaxy}/tokens": {
      "get": {
        "summary": "Get Tokens",
        "description": "The galaxy's anchor image token ids, as raw little-endian uint32.\n\nOne value per image patch, in row-major order: see `grid` in /meta.",
        "operationId": "get_tokens",
        "parameters": [
          {
            "name": "galaxy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMaximum": 17369,
              "title": "Galaxy"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/galaxies/{galaxy}/coverage": {
      "get": {
        "summary": "Get Coverage",
        "description": "Which surveys the galaxy was crossmatched into.",
        "operationId": "get_coverage",
        "parameters": [
          {
            "name": "galaxy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMaximum": 17369,
              "title": "Galaxy"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Survey"
                  },
                  "title": "Response Get Coverage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/similarity": {
      "get": {
        "summary": "Get Similarity",
        "description": "Galaxies ranked against the mean of the query patches, as Arrow IPC.\n\nOne record batch of three columns: the galaxy index, its best patch score,\nand a fixed-size list of one score per patch. Row 0 is always the query\ngalaxy itself. Candidates come from an approximate search, so fewer than\n`matches` rows can come back.",
        "operationId": "get_similarity",
        "parameters": [
          {
            "name": "galaxy",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMaximum": 17369,
              "title": "Galaxy"
            }
          },
          {
            "name": "p",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 576
              },
              "minItems": 1,
              "maxItems": 576,
              "title": "P"
            }
          },
          {
            "name": "matches",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 128,
              "minimum": 1,
              "default": 32,
              "title": "Matches"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/vnd.apache.arrow.stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Detail": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Detail",
        "description": "An error body."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Meta": {
        "properties": {
          "author": {
            "type": "string",
            "title": "Author"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          },
          "galaxies": {
            "type": "integer",
            "title": "Galaxies"
          },
          "grid": {
            "type": "integer",
            "title": "Grid"
          },
          "embeddings": {
            "type": "string",
            "title": "Embeddings"
          },
          "mean_points": {
            "type": "string",
            "title": "Mean Points"
          },
          "full_points": {
            "type": "string",
            "title": "Full Points"
          },
          "morphologies": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Morphologies"
          },
          "unlabelled": {
            "type": "integer",
            "title": "Unlabelled"
          }
        },
        "type": "object",
        "required": [
          "author",
          "id",
          "revision",
          "galaxies",
          "grid",
          "embeddings",
          "mean_points",
          "full_points",
          "morphologies",
          "unlabelled"
        ],
        "title": "Meta",
        "description": "What the frontend needs before it can render anything.\n\n`embeddings`, `mean_points` and `full_points` are artifact roles, not\nURLs: the client passes them back to `/artifacts/{role}`, so the server\nstays in charge of which artifact backs which view."
      },
      "Survey": {
        "properties": {
          "survey": {
            "type": "string",
            "title": "Survey"
          },
          "matched": {
            "type": "boolean",
            "title": "Matched"
          }
        },
        "type": "object",
        "required": [
          "survey",
          "matched"
        ],
        "title": "Survey",
        "description": "Whether one galaxy was crossmatched into one survey."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
