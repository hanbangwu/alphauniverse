    "/galaxy/{galaxy}/spectrum": {
      "get": {
        "summary": "Get Spectrum",
        "description": "The galaxy's spectrum for display, its flux smoothed with a Gaussian of sigma 2 pixels; masked pixels stay NaN.",
        "operationId": "get_spectrum",
        "parameters": [
          {
            "name": "galaxy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
