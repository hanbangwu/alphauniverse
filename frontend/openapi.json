    "/saliency": {
      "get": {
        "summary": "Get Saliency",
        "description": "For the query galaxy, at every slot of every mode, the partial correlation over every other galaxy between its score on the selection and its agreement with the query galaxy at that slot, controlling for its mean agreement outside the selection. With anywhere, the correlation runs over 512 other galaxies drawn at random with the query galaxy as the seed, and a mode named in anywhere takes, at each slot, the best agreement at any slot of that mode. One row, one list column per map.",
        "operationId": "get_saliency",
        "parameters": [
          {
            "name": "galaxy",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "title": "Galaxy"
            }
          },
          {
            "name": "ls_image",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 576
              },
              "maxItems": 576,
              "default": [],
              "title": "Ls Image"
            }
          },
          {
            "name": "hsc_image",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 576
              },
              "maxItems": 576,
              "default": [],
              "title": "Hsc Image"
            }
          },
          {
            "name": "desi_spectrum",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 272
              },
              "maxItems": 272,
              "default": [],
              "title": "Desi Spectrum"
            }
          },
          {
            "name": "sdss_spectrum",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 272
              },
              "maxItems": 272,
              "default": [],
              "title": "Sdss Spectrum"
            }
          },
          {
            "name": "table_values",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 26
              },
              "maxItems": 26,
              "default": [],
              "title": "Table Values"
            }
          },
          {
            "name": "anywhere",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "enum": [
                  "ls_image",
                  "hsc_image",
                  "desi_spectrum",
                  "sdss_spectrum"
                ],
                "type": "string"
              },
              "maxItems": 4,
              "default": [],
              "title": "Anywhere"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/vnd.apache.arrow.stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
